generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Condominium {
  id                           String                                   @id @default(uuid())
  legacyId                     Int?                                     @unique
  name                         String
  slug                         String                                   @unique
  isActive                     Boolean                                  @default(true)
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt
  updatedBy                    String?
  announcements                Announcement[]
  areaCharges                  AreaCharge[]
  budgets                      Budget[]
  charges                      Charge[]
  chargeGroups                 ChargeGroup[]
  commerces                    Commerce[]
  structureGroups              CondominiumStructureGroup[]
  structurePositions           CondominiumStructurePosition[]
  structurePositionAssignments CondominiumStructurePositionAssignment[]
  contacts                     ContactEntry[]
  expenses                     Expense[]
  incomes                      Income[]
  landUseCatalogs              LandUseCatalog[]
  meetings                     Meeting[]
  miscIncomeCatalogs           MiscIncomeCatalog[]
  notifications                Notification[]
  notificationCategories       NotificationCategory[]
  payments                     Payment[]
  paymentDetails               PaymentDetail[]
  paymentMethodCatalogs        PaymentMethodCatalog[]
  privateAreas                 PrivateArea[]
  privateAreaImages            PrivateAreaImage[]
  projects                     Project[]
  rentals                      Rental[]
  assignments                  ResidentAssignment[]
  roles                        Role[]
  sanctions                    SanctionCatalog[]
  subzoneCatalogs              SubzoneCatalog[]
  tickets                      Ticket[]
  ticketDepartments            TicketDepartment[]
  users                        User[]
  userCommerces                UserCommerce[]
  zoneCatalogs                 ZoneCatalog[]
  budgetExpenseConcepts        BudgetExpenseConcept[]
  budgetGroups                 BudgetGroup[]
  expenseConceptGroupMaps      ExpenseConceptGroupMap[]
  registrationTypes            RegistrationType[]
  businessLineCatalogs         BusinessLineCatalog[]
  businessCategoryCatalogs     BusinessCategoryCatalog[]
  businessSubcategoryCatalogs  BusinessSubcategoryCatalog[]
  rentalBusinessLines          RentalBusinessLine[]
  lucaTenantId                 String?                                  @unique
  // Cada condominio (tenant de Insulae) se liga 1 a 1 con un tenant
  // específico de Luca — su propia URL y secreto de firma, no uno global,
  // porque puede haber varios condominios compartiendo este deployment.
  lucaApiBaseUrl                String?
  lucaWebhookSecret             String?
  lucaSyncEvents               LucaSyncEvent[]
}

model User {
  id                             String                                   @id @default(uuid())
  condominiumId                  String
  legacyId                       Int?
  userType                       UserType                                 @default(INDIVIDUAL)
  firstName                      String?
  lastName                       String?
  lastNamePaterno                String?
  lastNameMaterno                String?
  businessName                   String?
  commercialName                 String?
  curp                           String?
  rfc                            String?
  address                        String?
  taxAddress                     String?
  email                          String?
  personalEmail                  String?
  businessEmail                  String?
  phone                          String?
  personalPhone                  String?
  businessPhone                  String?
  requiresInvoice                Boolean?
  taxStatusPdfUrl                String?
  initialRole                    String?
  passwordHash                   String?
  isActive                       Boolean                                  @default(true)
  createdAt                      DateTime                                 @default(now())
  updatedAt                      DateTime                                 @updatedAt
  administrativeCommerces        Commerce[]                               @relation("CommerceAdministrativeContact")
  operativeCommerces             Commerce[]                               @relation("CommerceOperativeContact")
  structurePositionAssignments   CondominiumStructurePositionAssignment[]
  rentalsAsAdministrativeContact Rental[]                                 @relation("RentalAdministrativeContact")
  rentalsAsOperativeContact      Rental[]                                 @relation("RentalOperativeContact")
  assignments                    ResidentAssignment[]
  openedTickets                  Ticket[]
  condominium                    Condominium                              @relation(fields: [condominiumId], references: [id])
  commerces                      UserCommerce[]
  userRoles                      UserRole[]
  birthDate                      DateTime?
  gender                         String?
  apolfap                        String?
  registrationTypeCode           String?
  registrationTypeDesc           String?
  idVq                           String?
  parentId                       String?
  parent                         User?                                    @relation("UserChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children                       User[]                                   @relation("UserChildren")

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
  @@index([email])
}

model Role {
  id            String           @id @default(uuid())
  condominiumId String           @default("85af33b0-38ac-4f92-bbc5-385e044ef53a")
  legacyId      Int?
  legacyIdGral  Int              @default(0)
  name          String
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  condominium   Condominium      @relation(fields: [condominiumId], references: [id])
  permissions   RolePermission[]
  userRoles     UserRole[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
}

model ModuleCatalog {
  id          String           @id @default(uuid())
  legacyId    Int?             @unique
  name        String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

model RolePermission {
  id        String        @id @default(uuid())
  roleId    String
  moduleId  String
  canCreate Boolean       @default(false)
  canUpdate Boolean       @default(false)
  canRead   Boolean       @default(false)
  canDelete Boolean       @default(false)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  module    ModuleCatalog @relation(fields: [moduleId], references: [id])
  role      Role          @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId])
}

model CondominiumStructureGroup {
  id            String                         @id @default(uuid())
  condominiumId String
  legacyId      Int?
  name          String
  position      Int                            @default(0)
  structureType Int                            @default(0)
  isActive      Boolean                        @default(true)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  condominium   Condominium                    @relation(fields: [condominiumId], references: [id])
  positions     CondominiumStructurePosition[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId, isActive, position])
}

model CondominiumStructurePosition {
  id                   String                                   @id @default(uuid())
  condominiumId        String
  groupId              String
  legacyId             Int?
  name                 String
  quantity             Int                                      @default(1)
  isAlternate          Boolean                                  @default(false)
  sortOrder            Int                                      @default(0)
  isActive             Boolean                                  @default(true)
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt
  invitedAnnouncements AnnouncementInvitedPosition[]
  condominium          Condominium                              @relation(fields: [condominiumId], references: [id])
  group                CondominiumStructureGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments          CondominiumStructurePositionAssignment[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId, isActive])
  @@index([groupId, isActive, sortOrder])
}

model CondominiumStructurePositionAssignment {
  id            String                       @id @default(uuid())
  condominiumId String
  positionId    String
  userId        String
  isAlternate   Boolean                      @default(false)
  isActive      Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  condominium   Condominium                  @relation(fields: [condominiumId], references: [id])
  position      CondominiumStructurePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId, isAlternate])
  @@index([condominiumId, isActive])
  @@index([positionId, isAlternate, isActive])
  @@index([userId, isActive])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model UserCommerce {
  id            String      @id @default(uuid())
  condominiumId String
  userId        String
  commerceName  String
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([condominiumId])
  @@index([userId])
  @@index([userId, isActive])
}

model Commerce {
  id                          String      @id @default(uuid())
  condominiumId               String
  legacyId                    Int?
  name                        String?
  administrativeContactUserId String?
  operativeContactUserId      String?
  isActive                    Boolean     @default(true)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  administrativeContactUser   User?       @relation("CommerceAdministrativeContact", fields: [administrativeContactUserId], references: [id])
  condominium                 Condominium @relation(fields: [condominiumId], references: [id])
  operativeContactUser        User?       @relation("CommerceOperativeContact", fields: [operativeContactUserId], references: [id])
  rentals                     Rental[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
  @@index([administrativeContactUserId])
  @@index([operativeContactUserId])
}

model PrivateArea {
  id                       String               @id @default(uuid())
  condominiumId            String
  legacyId                 Int?
  parentPrivateAreaId      String?
  sortOrder                Int                  @default(0)
  code                     String?
  name                     String
  zone                     String?
  subzone                  String?
  street                   String?
  useType                  String?
  status                   PrivateAreaStatus    @default(UNASSIGNED)
  isFusion                 Boolean              @default(false)
  m2Original               Decimal?             @db.Decimal(16, 6)
  m2Apole                  Decimal?             @db.Decimal(16, 6)
  m2Construction           Decimal?             @db.Decimal(16, 6)
  m2CommonArea             Decimal?             @db.Decimal(16, 6)
  m2ConstructionChildren   Decimal?             @db.Decimal(16, 6)
  m2CommonAreaChildren     Decimal?             @db.Decimal(16, 6)
  indiviso                 Decimal?             @db.Decimal(12, 6)
  vccc                     Decimal?             @db.Decimal(14, 6)
  isActive                 Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  updatedBy                String?
  level                    String?
  m2ConstructionCommonArea Decimal?             @db.Decimal(16, 6)
  lucaPropertyId           String?
  lucaPropertyCode         String?
  cus                      Decimal?             @db.Decimal(16, 6)
  cusPermitido             Decimal?             @db.Decimal(16, 6)
  areaCharges              AreaCharge[]
  attendances              Attendance[]
  charges                  Charge[]
  incomes                  Income[]
  payments                 Payment[]
  condominium              Condominium          @relation(fields: [condominiumId], references: [id])
  parentPrivateArea        PrivateArea?         @relation("PrivateAreaHierarchy", fields: [parentPrivateAreaId], references: [id])
  childPrivateAreas        PrivateArea[]        @relation("PrivateAreaHierarchy")
  images                   PrivateAreaImage[]
  rentals                  Rental[]
  assignments              ResidentAssignment[]
  tickets                  Ticket[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
  @@index([parentPrivateAreaId])
  @@index([condominiumId, parentPrivateAreaId, sortOrder])
  @@index([status])
  @@index([isFusion])
  @@index([condominiumId, lucaPropertyCode])
}

model PrivateAreaImage {
  id            String      @id @default(uuid())
  condominiumId String
  privateAreaId String
  url           String
  fileName      String
  fileSize      Int?
  mimeType      String?
  slotIndex     Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  privateArea   PrivateArea @relation(fields: [privateAreaId], references: [id], onDelete: Cascade)

  @@unique([privateAreaId, slotIndex])
  @@index([privateAreaId])
  @@index([condominiumId])
}

model ResidentAssignment {
  id            String      @id @default(uuid())
  condominiumId String
  userId        String
  privateAreaId String
  roleName      String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean     @default(true)
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  privateArea   PrivateArea @relation(fields: [privateAreaId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([condominiumId])
  @@index([userId])
  @@index([privateAreaId])
}

model Rental {
  id                          String               @id @default(uuid())
  condominiumId               String
  legacyId                    Int?
  privateAreaId               String
  commerceId                  String?
  tenantName                  String?
  administrativeContactUserId String?
  operativeContactUserId      String?
  startsAt                    DateTime?
  endsAt                      DateTime?
  status                      String?
  // Clase de comercio legacy (DCAT_CLASES_COMERCIOS): "A" | "B"
  businessClass               String?
  notes                       String?
  charges                     Charge[]
  businessLines               RentalBusinessLine[]
  administrativeContactUser   User?                @relation("RentalAdministrativeContact", fields: [administrativeContactUserId], references: [id])
  commerce                    Commerce?            @relation(fields: [commerceId], references: [id])
  condominium                 Condominium          @relation(fields: [condominiumId], references: [id])
  operativeContactUser        User?                @relation("RentalOperativeContact", fields: [operativeContactUserId], references: [id])
  privateArea                 PrivateArea          @relation(fields: [privateAreaId], references: [id])

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
  @@index([privateAreaId])
  @@index([commerceId])
  @@index([administrativeContactUserId])
  @@index([operativeContactUserId])
}

// Catálogo de giros comerciales (legacy DCAT_GIROS)
model BusinessLineCatalog {
  id            String                       @id @default(uuid())
  condominiumId String
  legacyId      Int?
  name          String
  code          String?
  isActive      Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  condominium   Condominium                  @relation(fields: [condominiumId], references: [id])
  categories    BusinessCategoryCatalog[]
  subcategories BusinessSubcategoryCatalog[]
  rentalLines   RentalBusinessLine[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId, isActive])
}

// Categorías comerciales por giro (legacy DCAT_CATEGORIAS_COMERCIAL)
model BusinessCategoryCatalog {
  id             String                       @id @default(uuid())
  condominiumId  String
  legacyId       Int?
  businessLineId String
  name           String
  code           String?
  isActive       Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  condominium    Condominium                  @relation(fields: [condominiumId], references: [id])
  businessLine   BusinessLineCatalog          @relation(fields: [businessLineId], references: [id])
  subcategories  BusinessSubcategoryCatalog[]
  rentalLines    RentalBusinessLine[]

  @@unique([condominiumId, legacyId])
  @@index([businessLineId])
  @@index([condominiumId, isActive])
}

// Subcategorías comerciales (legacy DCAT_SUBCATEGORIAS_COMERCIAL)
model BusinessSubcategoryCatalog {
  id             String                  @id @default(uuid())
  condominiumId  String
  legacyId       Int?
  categoryId     String
  businessLineId String
  name           String
  code           String?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  condominium    Condominium             @relation(fields: [condominiumId], references: [id])
  category       BusinessCategoryCatalog @relation(fields: [categoryId], references: [id])
  businessLine   BusinessLineCatalog     @relation(fields: [businessLineId], references: [id])
  rentalLines    RentalBusinessLine[]

  @@unique([condominiumId, legacyId])
  @@index([categoryId])
  @@index([condominiumId, isActive])
}

// Giros asignados a cada arrendamiento; el legacy permite hasta 4 slots
// (id_dcat_giros0..3) por negocio, cada uno con categoría/subcategoría.
model RentalBusinessLine {
  id             String                      @id @default(uuid())
  condominiumId  String
  rentalId       String
  slot           Int                         @default(0)
  businessLineId String
  categoryId     String?
  subcategoryId  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  condominium    Condominium                 @relation(fields: [condominiumId], references: [id])
  rental         Rental                      @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  businessLine   BusinessLineCatalog         @relation(fields: [businessLineId], references: [id])
  category       BusinessCategoryCatalog?    @relation(fields: [categoryId], references: [id])
  subcategory    BusinessSubcategoryCatalog? @relation(fields: [subcategoryId], references: [id])

  @@unique([rentalId, slot])
  @@index([condominiumId])
  @@index([businessLineId])
  @@index([categoryId])
}

model ChargeGroup {
  id                 String                   @id @default(uuid())
  condominiumId      String
  legacyId           Int?
  name               String
  chargeType         String?
  kind               ChargeGroupCanonicalKind @default(OTHER)
  isActive           Boolean                  @default(true)
  areaCharges        AreaCharge[]
  charges            Charge[]
  condominium        Condominium              @relation(fields: [condominiumId], references: [id])
  incomes            Income[]
  miscIncomeCatalogs MiscIncomeCatalog[]
  paymentDetails     PaymentDetail[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId])
  @@index([condominiumId, kind, isActive])
}

model AreaCharge {
  id            String             @id @default(uuid())
  condominiumId String
  privateAreaId String
  chargeGroupId String
  amount        Decimal            @db.Decimal(14, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean            @default(true)
  miscCatalogId String?
  chargeGroup   ChargeGroup        @relation(fields: [chargeGroupId], references: [id])
  condominium   Condominium        @relation(fields: [condominiumId], references: [id])
  miscCatalog   MiscIncomeCatalog? @relation(fields: [miscCatalogId], references: [id])
  privateArea   PrivateArea        @relation(fields: [privateAreaId], references: [id])

  @@index([condominiumId])
  @@index([privateAreaId])
  @@index([chargeGroupId])
  @@index([miscCatalogId])
}

model Charge {
  id               String               @id @default(uuid())
  condominiumId    String
  privateAreaId    String
  chargeGroupId    String
  tenancyId        String?
  legacyId         Int?
  legacyStatusCode Int?
  concept          String?
  responsibility   ChargeResponsibility @default(OWNER)
  periodYear       Int
  periodMonth      Int
  amount           Decimal              @db.Decimal(14, 2)
  paidAmount       Decimal              @default(0) @db.Decimal(14, 2)
  interestAmount   Decimal              @default(0) @db.Decimal(14, 2)
  discountAmount   Decimal              @default(0) @db.Decimal(14, 2)
  isCollectible    Boolean              @default(true)
  dueDate          DateTime?
  status           LedgerStatus         @default(OPEN)
  createdAt        DateTime             @default(now())
  chargeGroup      ChargeGroup          @relation(fields: [chargeGroupId], references: [id])
  condominium      Condominium          @relation(fields: [condominiumId], references: [id])
  privateArea      PrivateArea          @relation(fields: [privateAreaId], references: [id])
  tenancy          Rental?              @relation(fields: [tenancyId], references: [id])
  allocations      PaymentAllocation[]

  @@unique([condominiumId, legacyId])
  @@index([condominiumId, periodYear, periodMonth])
  @@index([privateAreaId])
  @@index([privateAreaId, responsibility, periodYear, periodMonth])
  @@index([tenancyId])
  @@index([condominiumId, legacyStatusCode])
  @@index([responsibility])
}

model Payment {
  id                          String              @id @default(uuid())
  condominiumId               String
  legacyId                    Int?
  privateAreaId               String?
  isVisibleInFinancialSummary Boolean             @default(true)
  legacyStatusCode            Int?
  isLegacyActive              Boolean?
  legacyAreaCode              Int?
  legacyAreaIsActive          Boolean?
  paidAt                      DateTime
  amount                      Decimal             @db.Decimal(14, 2)
  method                      PaymentMethod
  reference                   String?
  notes                       String?
  createdAt                   DateTime            @default(now())
  condominium                 Condominium         @relation(fields: [condominiumId], references: [id])
  privateArea                 PrivateArea?        @relation(fields: [privateAreaId], references: [id])
  allocations                 PaymentAllocation[]
  details                     PaymentDetail[]

  @@unique([condominiumId, legacyId])
  @@index([privateAreaId])
  @@index([condominiumId, isVisibleInFinancialSummary])
  @@index([condominiumId, legacyStatusCode])
  @@index([condominiumId, legacyAreaIsActive])
  @@index([condominiumId, paidAt])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  chargeId  String
  paymentId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  charge    Charge   @relation(fields: [chargeId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@index([paymentId])
}

model PaymentDetail {
  id            String       @id @default(uuid())
  condominiumId String
  legacyId      Int?
  paymentId     String
  chargeGroupId String?
  amount        Decimal      @db.Decimal(14, 2)
  creditBalance Decimal?     @db.Decimal(14, 2)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  chargeGroup   ChargeGroup? @relation(fields: [chargeGroupId], references: [id])
  condominium   Condominium  @relation(fields: [condominiumId], references: [id])
  payment       Payment      @relation(fields: [paymentId], references: [id])

  @@unique([condominiumId, legacyId])
  @@index([paymentId])
  @@index([chargeGroupId])
}

model PaymentMethodCatalog {
  id            String      @id @default(uuid())
  condominiumId String
  legacyId      Int?
  name          String
  isActive      Boolean     @default(true)
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  @@unique([condominiumId, legacyId])
}

model ZoneCatalog {
  id            String           @id @default(uuid())
  condominiumId String
  legacyId      Int?
  name          String
  initials      String?
  marketValue   Decimal?         @db.Decimal(14, 2)
  weight        Decimal?         @db.Decimal(12, 4)
  isActive      Boolean          @default(true)
  subzones      SubzoneCatalog[]
  condominium   Condominium      @relation(fields: [condominiumId], references: [id])

  @@unique([condominiumId, legacyId])
}

model SubzoneCatalog {
  id            String       @id @default(uuid())
  condominiumId String
  legacyId      Int?
  zoneId        String?
  name          String
  initials      String?
  isActive      Boolean      @default(true)
  condominium   Condominium  @relation(fields: [condominiumId], references: [id])
  zone          ZoneCatalog? @relation(fields: [zoneId], references: [id])

  @@unique([condominiumId, legacyId])
  @@index([zoneId])
}

model LandUseCatalog {
  id            String      @id @default(uuid())
  condominiumId String
  legacyId      Int?
  name          String
  initials      String?
  order         Int?
  weight        Decimal?    @db.Decimal(12, 4)
  percentage    Decimal?    @db.Decimal(12, 6)
  isActive      Boolean     @default(true)
  costPerM2     Decimal?    @db.Decimal(14, 2)
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  @@unique([condominiumId, legacyId])
}

model MiscIncomeCatalog {
  id                  String       @id @default(uuid())
  condominiumId       String
  legacyId            Int?
  chargeGroupId       String?
  name                String
  legacyChargeGroupId Int?
  isActive            Boolean      @default(true)
  order               Int          @default(0)
  quotaPeriodEnd      DateTime?
  quotaPeriodStart    DateTime?
  areaCharges         AreaCharge[]
  incomes             Income[]
  chargeGroup         ChargeGroup? @relation(fields: [chargeGroupId], references: [id])
  condominium         Condominium  @relation(fields: [condominiumId], references: [id])

  @@unique([condominiumId, legacyId])
  @@index([chargeGroupId])
  @@index([condominiumId, isActive, chargeGroupId])
  @@index([condominiumId, isActive, legacyChargeGroupId])
}

model Income {
  id                  String             @id @default(uuid())
  condominiumId       String
  legacyId            Int?
  chargeGroupId       String?
  miscCatalogId       String?
  privateAreaId       String?
  date                DateTime
  concept             String
  amount              Decimal            @db.Decimal(14, 2)
  isActive            Boolean            @default(true)
  legacyChargeGroupId Int?
  legacyMiscCatalogId Int?
  legacyPrivateAreaId Int?
  isConfirmed         Boolean?
  paymentMethod       PaymentMethod?
  notes               String?
  receiptUrl          String?
  accountingNote      String?
  externalSource      String?
  externalId          String?
  lockedAt            DateTime?
  lockedBy            String?
  reference           String?
  chargeGroup         ChargeGroup?       @relation(fields: [chargeGroupId], references: [id])
  condominium         Condominium        @relation(fields: [condominiumId], references: [id])
  miscCatalog         MiscIncomeCatalog? @relation(fields: [miscCatalogId], references: [id])
  privateArea         PrivateArea?       @relation(fields: [privateAreaId], references: [id])

  @@unique([condominiumId, legacyId])
  @@unique([condominiumId, externalSource, externalId])
  @@index([condominiumId, isActive, date])
  @@index([chargeGroupId])
  @@index([miscCatalogId])
  @@index([privateAreaId])
  @@index([condominiumId, legacyChargeGroupId])
  @@index([condominiumId, legacyMiscCatalogId, legacyChargeGroupId, isActive, date])
}

model Expense {
  id                    String                @id @default(uuid())
  condominiumId         String
  legacyId              Int?
  date                  DateTime
  concept               String
  amount                Decimal               @db.Decimal(14, 2)
  isActive              Boolean               @default(true)
  budgetConceptId       String?
  legacyBudgetConceptId Int?
  legacyReceipt         String?
  receiptUrl            String?
  accountingNote        String?
  externalSource        String?
  externalId            String?
  lockedAt              DateTime?
  lockedBy              String?
  reference             String?
  legacyProjectName     String?
  projectName           String?
  paymentMethod         PaymentMethod?
  notes                 String?
  // Grupo presupuestal que Luca vinculó al recibir el gasto (por
  // BudgetGroup.lucaAccountCode) — se ubica al recibir, y la partida
  // específica (budgetConceptId) se elige después, al ejecutar.
  budgetGroupId         String?
  budgetConcept         BudgetExpenseConcept? @relation(fields: [budgetConceptId], references: [id])
  budgetGroup           BudgetGroup?          @relation(fields: [budgetGroupId], references: [id])
  condominium           Condominium           @relation(fields: [condominiumId], references: [id])

  @@unique([condominiumId, legacyId])
  @@unique([condominiumId, externalSource, externalId])
  @@index([condominiumId, isActive, date])
  @@index([budgetConceptId])
  @@index([budgetGroupId])
  @@index([condominiumId, legacyBudgetConceptId])
}

model Budget {
  id                      String                   @id @default(uuid())
  condominiumId           String
  legacyId                Int?
  year                    Int
  name                    String?
  isActive                Boolean                  @default(true)
  status                  BudgetStatus             @default(OPEN)
  condominium             Condominium              @relation(fields: [condominiumId], references: [id])
  lines                   BudgetLine[]
  expenseConcepts         BudgetExpenseConcept[]
  budgetGroups            BudgetGroup[]
  expenseConceptGroupMaps ExpenseConceptGroupMap[]

  @@unique([condominiumId, year])
}

model BudgetGroup {
  id            String                 @id @default(uuid())
  condominiumId String                 @map("condominium_id")
  year          Int
  name          String
  isActive      Boolean                @default(true) @map("is_active")
  legacyId      Int?                   @map("legacy_id")
  order         Int                    @default(0)
  parentId      String?                @map("parent_id")
  category      String                 @default("OTHER")
  startsAt      DateTime?              @map("starts_at")
  endsAt        DateTime?              @map("ends_at")
  // Integración Luca <-> Insulae (egresos): el grupo completo (no cada
  // partida) se vincula a UNA cuenta de Pasivo/Egresos de Luca. Al recibir
  // un gasto de esa cuenta, Insulae ubica el grupo aquí y pide elegir la
  // partida específica antes de ejecutar (ver Expense.budgetGroupId).
  lucaAccountId   String?              @map("luca_account_id")
  lucaAccountCode String?              @map("luca_account_code")
  concepts      BudgetExpenseConcept[]
  expenses      Expense[]
  condominium   Condominium            @relation(fields: [condominiumId], references: [id])
  budget        Budget                 @relation(fields: [condominiumId, year], references: [condominiumId, year])
  parent        BudgetGroup?           @relation("BudgetGroupToParent", fields: [parentId], references: [id])
  children      BudgetGroup[]          @relation("BudgetGroupToParent")

  @@unique([condominiumId, year, legacyId])
  @@unique([condominiumId, year, lucaAccountCode])
  @@index([condominiumId, year, isActive])
  @@map("budget_group")
}

model BudgetExpenseConcept {
  id                    String                   @id @default(uuid())
  condominiumId         String                   @map("condominium_id")
  year                  Int
  name                  String
  budgetGroupId         String?                  @map("budget_group_id")
  isActive              Boolean                  @default(true) @map("is_active")
  legacyBudgetConceptId Int?                     @map("legacy_budget_concept_id")
  source                String                   @default("legacy_etl")
  order                 Int                      @default(0)
  type                  String                   @default("N/A")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  budgetGroup           String                   @default("OTHER") @map("group")
  lucaAccountId         String?                  @map("luca_account_id")
  lucaAccountCode       String?                  @map("luca_account_code")
  budgetLines           BudgetLine[]
  expenses              Expense[]
  group                 BudgetGroup?             @relation(fields: [budgetGroupId], references: [id])
  condominium           Condominium              @relation(fields: [condominiumId], references: [id])
  budget                Budget                   @relation(fields: [condominiumId, year], references: [condominiumId, year])
  mappings              ExpenseConceptGroupMap[]

  @@unique([condominiumId, year, legacyBudgetConceptId])
  @@unique([condominiumId, year, lucaAccountCode])
  @@index([condominiumId, year, budgetGroup, isActive])
  @@index([condominiumId, year, isActive])
  @@index([condominiumId, year, name])
  @@map("budget_expense_concept")
}

model BudgetLine {
  id              String                @id @default(uuid())
  budgetId        String
  legacyId        Int?
  concept         String
  groupName       String?
  annualAmount    Decimal?              @db.Decimal(14, 2)
  unitCost        Decimal?              @db.Decimal(14, 2)
  supplierUrl     String?
  budgetConceptId String?
  budgetConcept   BudgetExpenseConcept? @relation(fields: [budgetConceptId], references: [id])
  budget          Budget                @relation(fields: [budgetId], references: [id])
  months          BudgetMonth[]

  @@index([budgetId])
  @@index([budgetConceptId])
}

model BudgetMonth {
  id           String     @id @default(uuid())
  budgetLineId String
  month        Int
  amount       Decimal    @db.Decimal(14, 2)
  units        Decimal?   @db.Decimal(14, 2)
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id])

  @@unique([budgetLineId, month])
}

model ExpenseConceptGroupMap {
  id                    BigInt                @id @default(autoincrement())
  condominiumId         String                @map("condominium_id")
  year                  Int
  legacyBudgetConceptId Int                   @map("legacy_budget_concept_id")
  budgetConceptId       String?               @map("budget_concept_id")
  budgetGroupId         Int                   @map("budget_group_id")
  isBudgetConceptActive Boolean               @default(true) @map("is_budget_concept_active")
  source                String                @default("legacy_etl")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  budgetConcept         BudgetExpenseConcept? @relation(fields: [budgetConceptId], references: [id])
  condominium           Condominium           @relation(fields: [condominiumId], references: [id])
  budget                Budget                @relation(fields: [condominiumId, year], references: [condominiumId, year])

  @@unique([condominiumId, year, legacyBudgetConceptId])
  @@index([year, legacyBudgetConceptId])
  @@index([budgetConceptId])
  @@index([condominiumId, year, budgetGroupId])
  @@index([condominiumId, year, isBudgetConceptActive])
  @@map("expense_concept_group_map")
}

